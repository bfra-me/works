{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "scripts/src/**/*.ts",
    "scripts/test/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/lib/**",
    "**/dist/**",
    "**/test/fixtures/**",
    "**/test/_fixtures/**"
  ]
}
